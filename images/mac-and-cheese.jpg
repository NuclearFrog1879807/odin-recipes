function parseApplicableSectionsFromGppString(gppString) {
if (!gppString || typeof gppString !== 'string') {
return null;
}
var trimmed = gppString.replace(/^[ \t\r\n\f\v]+|[ \t\r\n\f\v]+$/g, '');
if (!trimmed) {
return null;
}
var headerEnc = trimmed.indexOf('~') === -1 ? trimmed : trimmed.split('~')[0];
if (!headerEnc) {
return null;
}
function headerCharValue(ch) {
if (ch >= 'A' && ch <= 'Z') {
return ch.charCodeAt(0) - 65;
}
if (ch >= 'a' && ch <= 'z') {
return ch.charCodeAt(0) - 71;
}
if (ch >= '0' && ch <= '9') {
return ch.charCodeAt(0) + 4;
}
if (ch === '+' || ch === '-') {
return 62;
}
if (ch === '/' || ch === '_') {
return 63;
}
return -1;
}
var bits = [];
var ci;
for (ci = 0; ci < headerEnc.length; ci++) {
var v = headerCharValue(headerEnc.charAt(ci));
if (v === -1) {
return null;
}
var b;
for (b = 32; b >= 1; b >>= 1) {
bits.push((v & b) ? 1 : 0);
}
}
var pos = 0;
function readBits(n) {
if (pos + n > bits.length) {
throw new Error('eof');
}
var acc = 0;
var i;
for (i = 0; i < n; i++) {
acc = (acc << 1) | bits[pos++];
}
return acc;
}
function readFibonacciInt() {
var codeword = [];
while (true) {
codeword.push(readBits(1));
var len = codeword.length;
if (len >= 2 && codeword[len - 2] === 1 && codeword[len - 1] === 1) {
codeword.pop();
break;
}
if (len > 48) {
throw new Error('fib');
}
}
var weights = [1, 2];
while (weights.length < codeword.length) {
var wl = weights.length;
weights.push(weights[wl - 1] + weights[wl - 2]);
}
var sum = 0;
var j;
for (j = 0; j < codeword.length; j++) {
if (codeword[j] === 1) {
sum += weights[j];
}
}
return sum;
}
try {
var MAX_APPLICABLE_IDS = 256;
var MAX_GROUP_SPAN = 255;
var type = readBits(6);
if (type !== 3) {
return null;
}
readBits(6);
var itemCount = readBits(12);
if (itemCount < 0 || itemCount > 64) {
return null;
}
var lastId = 0;
var out = [];
var idx;
for (idx = 0; idx < itemCount; idx++) {
var isGroup = readBits(1) === 1;
if (!isGroup) {
var delta = readFibonacciInt();
var sid = lastId + delta;
if (out.length >= MAX_APPLICABLE_IDS) {
return null;
}
out.push(sid);
lastId = sid;
} else {
var startOff = readFibonacciInt();
var span = readFibonacciInt();
var startId = lastId + startOff;
var encodedEndId = startId + span;
if (!Number.isFinite(startId) || !Number.isFinite(encodedEndId) || encodedEndId < startId) {
return null;
}
var spanUse = span > MAX_GROUP_SPAN ? MAX_GROUP_SPAN : span;
var endId = startId + spanUse;
var rangeLen = endId - startId + 1;
if (out.length + rangeLen > MAX_APPLICABLE_IDS) {
return null;
}
var s;
for (s = startId; s <= endId; s++) {
out.push(s);
}
lastId = encodedEndId;
}
}
return out;
} catch (e2) {
return null;
}
}
