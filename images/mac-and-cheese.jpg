<script id="allrecipes-schema_1-0" class="comp allrecipes-schema mntl-schema-unified" type="application/ld+json">[
{
"@context": "http://schema.org",
"@type": ["Recipe","NewsArticle"]
,"headline": "Simple Macaroni and Cheese"
,"datePublished": "2019-04-02T03:03:32-04:00"
,"dateModified": "2026-08-12T08:13:44-04:00"
,"author": [ {"@type": "Person"
,"name": "g0dluvsugly" }
]
,"description": "This mac and cheese recipe is simple to prepare with seven ingredients you most likely already have on hand for a deliciously rich, comforting meal."
,"image": {
"@type": "ImageObject",
"url": "https://www.allrecipes.com/thmb/xI5g0WBP8yPHwRt1Nt5WudTctzE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238691-Simple-Macaroni-And-Cheese-mfs_008-b32db5aa505041acbe958aedb81d29e9.jpg",
"height": 1125,
"width": 1500
}
,"video": {
"@type": "VideoObject",
"contentUrl": "https://content.jwplatform.com/videos/zqi3LcfG-K3AjnAEN.mp4",
"description": "Want a fancier macaroni and cheese without needing all different types of cheeses? This macaroni and cheese dish gives the impression of a more upscale version, but with more readily accessible ingredients. Pair with summer vegetables or have along other side dishes during a potluck!",
"duration": "PT50S",
"name": "Simple Macaroni and Cheese",
"thumbnailUrl": "https://cdn.jwplayer.com/v2/media/zqi3LcfG/thumbnails/ShZFyqeR.jpg?width=1280",
"uploadDate": "2022-04-12T16:40:46-04:00"}
,"publisher": {
"@type": "Organization",
"name": "Allrecipes",
"url": "https://www.allrecipes.com",
"logo": {
